{
  "name": "claude-memory-atlas",
  "version": "0.1.0",
  "description": "Render Claude Code auto-memory markdown files as a self-contained, offline-capable interactive HTML knowledge graph.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "memory-atlas": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "memory",
    "knowledge-graph",
    "visualization",
    "cli"
  ],
  "author": "jimmyjames177414",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmyjames177414/claude-memory-atlas.git"
  },
  "homepage": "https://github.com/jimmyjames177414/claude-memory-atlas#readme",
  "bugs": {
    "url": "https://github.com/jimmyjames177414/claude-memory-atlas/issues"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "force-graph": "^1.51.4",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
